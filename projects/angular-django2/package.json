{
  "name": "angular-django2",
  "version": "0.5.0",
  "description": "Angular workspace for a Django-friendly Angular CLI schematics collection.",
  "keywords": [
    "angular",
    "django",
    "npm",
    "schematics"
  ],
  "license": "MIT",
  "homepage": "https://github.com/shlomoa/angular-django2#readme",
  "bugs": {
    "url": "https://github.com/shlomoa/angular-django2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlomoa/angular-django2.git"
  },
  "schematics": "./schematics/collection.json",
  "exports": {
    "./schematics/*.json": "./schematics/*.json",
    "./schematics/*": {
      "types": "./schematics/*.d.ts",
      "default": "./schematics/*.js"
    },
    "./README.md": "./README.md",
    "./package.json": "./package.json"
  },
  "ng-add": {
    "save": "devDependencies"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "build": "cpy package.json README.md dist/ && tsc -p tsconfig.schematics.json && cpy \"*.json\" \"*/schema.json\" \"../dist/schematics/\" --cwd=schematics/",
    "compile": "tsc -p tsconfig.schematics.json",
    "pack": "npm run build && npm pack ./dist",
    "pack:dry-run": "npm run build && npm pack ./dist --dry-run",
    "release:prepare": "npm run build && npm run pack:dry-run",
    "publish:dry-run": "npm publish ./dist --dry-run --access public",
    "publish:package": "npm publish ./dist --access public",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --workspace=angular-django-validation run test:unit"
  },
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@shlomoa/openui-spec": "^0.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.0.9",
    "@angular-devkit/schematics": "^22.0.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
