    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "angular-django2": "file:../angular-django2/dist"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.0.9",
    "@angular-devkit/schematics": "^22.0.9",
    "@angular-eslint/builder": "^22.1.0",
    "@angular/build": "^22.0.9",
    "@angular/cli": "^22.0.9",
    "@angular/compiler-cli": "^22.0.8",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
